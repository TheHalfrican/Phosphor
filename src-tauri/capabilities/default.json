{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window. Tauri v2 denies by default, so every API the UI touches is listed explicitly.",
  "windows": ["main"],
  "permissions": [
    "core:default",

    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",

    "core:event:default",

    "dialog:allow-open",
    "dialog:allow-save",

    "opener:default"
  ]
}
